PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/shadowchat

# Firebase Admin credentials
# EITHER set the 3 vars below OR point GOOGLE_APPLICATION_CREDENTIALS to your service-account json file
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Optional: strict token revocation checks
FIREBASE_CHECK_REVOKED=false

# Optional SMTP for verification/reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ShadowChat <no-reply@example.com>"

UPLOADS_DIR=uploads
MAX_UPLOAD_MB=25
MAX_VOICE_NOTE_MB=15
